# iKuai Q3000 配置叠加层
#
# 用法（见 .github/workflows/build-q3000.yml）：
#   1. cp -f defconfig/mt7981-ax3000.config .config   # 官方 mt7981 配置模板
#   2. cat q3000/q3000-overlay.config >> .config       # 追加本文件（Q3000 支持）
#   3. make defconfig
#
# 注意：本文件是"叠加层"不是完整配置，不要单独作为 .config 使用。
# 模板里已经包含了正确的 WARP_VERSION=2 / WARP_CHIPSET="mt7981"、
# kmod-mt_wifi、kmod-warp、LuCI 等，不需要在这里重复。

# Q3000 设备（由 q3000/patch_q3000.py 加入 target/linux/mediatek/image/mt7981.mk）
CONFIG_TARGET_DEVICE_mediatek_mt7981_DEVICE_ikuai_q3000=y
CONFIG_TARGET_DEVICE_PACKAGES_mediatek_mt7981_DEVICE_ikuai_q3000=""

# LuCI 中文界面
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y

# Argon 主题设置界面
CONFIG_PACKAGE_luci-app-argon-config=y
